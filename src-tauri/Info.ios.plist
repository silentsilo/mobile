<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the generated Info.plist. iOS ends an app that
     asks for Face ID without saying why. -->
<plist version="1.0">
<dict>
	<key>NSFaceIDUsageDescription</key>
	<string>SilentSilo uses Face ID to open your silos on this iPhone.</string>
	<key>NSCameraUsageDescription</key>
	<string>SilentSilo takes a photo straight into your silo, encrypted on this iPhone.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SilentSilo saves a file from your silo to Photos when you choose to.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SilentSilo backs up the photos and videos you choose to your silo, encrypted on this iPhone.</string>
	<key>NSContactsUsageDescription</key>
	<string>SilentSilo backs up your contacts to your silo, encrypted on this iPhone.</string>
	<!-- Phone backup: iOS runs it when it chooses (Backup.swift). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.silentsilo.mobile.backup</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SilentSilo connects to the backup server on your network that you set up for your silo.</string>
	<key>NFCReaderUsageDescription</key>
	<string>SilentSilo reads a security key held to the iPhone to open your silos.</string>
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>A0000006472F0001</string>
	</array>
	<!-- Standard algorithms beyond the system's (AES-GCM, Argon2id, HKDF,
	     ECDH). App Store Connect still asks about export at each upload
	     until it has a compliance code (the French declaration brings one). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
</dict>
</plist>
