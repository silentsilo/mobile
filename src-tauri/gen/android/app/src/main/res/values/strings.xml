    <string name="autofill_choose_for">Choose a login for %1$s</string>
    <!-- %1$s is a browser, by name and package. It shows a web page but is not on the list of browsers SilentSilo believes about which site is open, so nothing is suggested and the user searches by hand. -->
    <string name="autofill_unverified_browser">SilentSilo cannot confirm which site is open in %1$s, so it suggests nothing. Check the address bar and choose a login for that site only.</string>
    <!-- Asked after the user picks a login by hand from the search. -->
    <string name="autofill_confirm_title">Fill this login?</string>
    <!-- %1$s is where the login was saved (a site or an app package), %2$s is the site or app asking for it now. -->
    <string name="autofill_confirm_message">It was saved for %1$s, and %2$s is asking for it. Fill it only if both are the same service.</string>
