/* AutoFill sheet: its title, above the list of logins. */
"af.title" = "Choose a login";
/* AutoFill sheet: the button that closes it. */
"af.cancel" = "Cancel";
/* AutoFill sheet: placeholder of the search field. */
"af.search" = "Search";
/* AutoFill sheet: heading over the logins saved for the site or app asking. */
"af.suggested" = "For this site";
/* AutoFill sheet: heading over every other login. */
"af.all" = "All logins";
/* AutoFill sheet: while Face ID and the silo open. */
"af.opening" = "Opening your silo…";
/* AutoFill sheet: the silo holds no login. */
"af.empty" = "This silo has no logins yet.";
/* AutoFill sheet: button after a failure. */
"af.retry" = "Try again";
/* AutoFill sheet: the silo could not be opened; the reason follows on its own line. */
"af.failed" = "The silo did not open.";
/* AutoFill sheet: in place of a login's username when it has none. */
"af.no_user" = "No username";
/* AutoFill sheet: line under the title naming the site that asks for a login; %@ is its address, such as example.com. */
"af.asking" = "Asked by: %@";
/* AutoFill sheet: the same line when iOS did not say which app or site asks. */
"af.asking_unknown" = "Asked by: an app or site that iOS did not name";
/* AutoFill sheet: title of the question shown before filling a login saved for another site, or when iOS did not name the site asking. */
"af.confirm_title" = "Fill this login?";
/* AutoFill sheet: body of that question. %1$@ is the site the login is saved for, %2$@ the site asking. Keep the line breaks and the label style of af.asking. */
"af.confirm_other" = "Saved for: %1$@\nAsked by: %2$@\n\nThese are different sites.";
/* AutoFill sheet: body of that question when iOS did not name the site asking. %@ is the site the login is saved for. Keep the line break. */
"af.confirm_unknown" = "Saved for: %@\nAsked by: an app or site that iOS did not name";
/* AutoFill sheet: button in that question that fills the login into the site asking. */
"af.fill" = "Fill";
/* AutoFill sheet: in place of the login's site in that question, when the login has neither an address nor a name. */
"af.no_site" = "No site";
