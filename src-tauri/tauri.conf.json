{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SilentSilo",
  "version": "1.4.0",
  "identifier": "com.silentsilo.mobile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "SilentSilo", "width": 390, "height": 844 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: silo: http://silo.localhost; connect-src 'self' ipc: http://ipc.localhost silo: http://silo.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Software Hive S.R.L.",
    "copyright": "Copyright (C) 2026 Software Hive S.R.L.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "android": { "minSdkVersion": 31 },
    "iOS": { "developmentTeam": "J3YBNT5RQ3", "minimumSystemVersion": "17.0" }
  }
}
